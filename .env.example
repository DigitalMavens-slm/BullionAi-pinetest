# ===== BullionAI production environment (copy to .env and fill in) =====

# Shoonya OAuth
SHOONYA_CLIENT_ID=FN215549_U
SHOONYA_SECRET_CODE=YOUR_SHOONYA_SECRET_CODE
# MUST be the exact HTTPS URL you browse to when logging in.
SHOONYA_REDIRECT_URL=https://bullionai.in/

# Optional: if your host's egress IP is whitelisted, set it to override IP headers.
SHOONYA_WHITELISTED_IP=YOUR_VPS_OR_HOST_IP

# ---- Database (PostgreSQL) ----
# Replace USER and HOST with your Render PostgreSQL values.
# Password is URL-encoded (@ -> %40).
DATABASE_URL=postgres://USER:Bislm%402026@HOST:5432/bullionai?sslmode=require

# Comma-separated emails that are always admins (first registered user is also admin).
ADMIN_EMAILS=sheriff.sheikh12@gmail.com

# Defaults (MCX)
# NOTE: These are only FALLBACKS. The backend auto-selects the CURRENT active
# contract per instrument from the SymbolMaster registry (nearest expiry beyond
# the rollover buffer) via GET /api/contract and /api/candles|/api/strategy.
# You can leave these as-is; they are used only if the registry is unavailable.
SHOONYA_EXCHANGE=MCX
SHOONYA_GOLD_SYMBOL=GOLD05OCT26
SHOONYA_GOLD_TOKEN=483079
SHOONYA_TOKEN=483079
SHOONYA_SILVER_SYMBOL=SILVER04SEP26
SHOONYA_SILVER_TOKEN=471725

# ---- Spot Gold/Silver (gold-api.com) ----
# Live XAU/USD & XAG/USD spot price works with NO key (free, unlimited).
# Historical OHLC candles (chart history + strategy) need a free API key.
# Get one at https://gold-api.com ; free tier = 10 req/hr (we backfill a big
# window once and cache to disk, so the limit is a non-issue).
# GOLD_API_KEY=YOUR_GOLD_API_KEY
# GOLD_API_URL=https://api.gold-api.com

# Backend port
PORT=8787
NODE_ENV=production

# ---- Daily Shoonya session alert (render.yaml cron: bullionai-session-check) ----
# The cron pings the backend and alerts before market open if the Shoonya
# session is missing/expired so live prices don't silently go stale.
BACKEND_URL=https://bullionai-pinetest.onrender.com
# Alert channel: either SendGrid (Render's built-in email) OR a webhook.
SENDGRID_FROM=noreply@bullionai.digitalmavens.in
SENDGRID_TO=sheriff.sheikh12@gmail.com
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
# ALERT_WEBHOOK_URL=https://api.telegram.org/bot<token>/sendMessage  (optional webhook)
# ALERT_WEBHOOK_TOKEN=
# Minutes ahead of expiry to warn (default 30).
# SESSION_EXPIRY_WARN_MINUTES=30
