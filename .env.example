# ===== BullionAI production environment (copy to .env and fill in) =====

# Shoonya OAuth
SHOONYA_CLIENT_ID=FN215549_U
SHOONYA_SECRET_CODE=YOUR_SHOONYA_SECRET_CODE
# MUST be the exact HTTPS URL you browse to when logging in.
SHOONYA_REDIRECT_URL=https://bullionai.in/

# Optional: if your host's egress IP is whitelisted, set it to override IP headers.
SHOONYA_WHITELISTED_IP=YOUR_VPS_OR_HOST_IP

# ---- Database (PostgreSQL) ----
# Replace USER and HOST with your Render PostgreSQL values.
# Password is URL-encoded (@ -> %40).
DATABASE_URL=postgres://USER:Bislm%402026@HOST:5432/bullionai?sslmode=require

# Comma-separated emails that are always admins (first registered user is also admin).
ADMIN_EMAILS=sheriff.sheikh12@gmail.com

# Defaults (MCX)
SHOONYA_EXCHANGE=MCX
SHOONYA_GOLD_SYMBOL=GOLD05OCT26
SHOONYA_GOLD_TOKEN=483079
SHOONYA_TOKEN=483079
SHOONYA_SILVER_SYMBOL=SILVER04SEP26
SHOONYA_SILVER_TOKEN=471725

# Backend port
PORT=8787
NODE_ENV=production
